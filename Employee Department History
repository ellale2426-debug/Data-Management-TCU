SELECT * from 
	humanresources.employee
      humanresources.department
      humanresources.employee_department_history
      person.person
      person.phone
      person.phone_number_type

--Q1
SELECT 
      h."BusinessEntityID", 
      p."FirstName", 
      p."LastName", 
      h."JobTitle"
FROM person.person p
JOIN humanresources.employee h 
  ON h."BusinessEntityID" = p."BusinessEntityID"
JOIN humanresources.employee_department_history dh 
  ON h."BusinessEntityID" = dh."BusinessEntityID"
WHERE dh."EndDate" IS NULL
ORDER BY 3,2

--Q2
SELECT 
      p."FirstName", 
      p."LastName", 
      h."HireDate", 
      h."JobTitle"
FROM humanresources.employee h
JOIN person.person p 
  ON h."BusinessEntityID" = p."BusinessEntityID"
WHERE h."HireDate" > '2008-01-01'
ORDER BY 3 

--Q3
SELECT distinct
      p."FirstName", 
      p."LastName",  
      e."JobTitle"
FROM humanresources.employee e
JOIN person.person p 
  ON e."BusinessEntityID" = p."BusinessEntityID"
JOIN humanresources.employee_department_history dh 
  ON e."BusinessEntityID" = dh."BusinessEntityID"
JOIN humanresources.department d
  ON dh."DepartmentID" = d."DepartmentID"
WHERE d."Name" IN ('Engineering', 'Research and Development')
  AND dh."EndDate" IS NULL

--Q4
SELECT 
      p."FirstName", 
      p."LastName",  
      e."JobTitle"
FROM humanresources.employee e
JOIN person.person p 
  ON e."BusinessEntityID" = p."BusinessEntityID"
WHERE e."JobTitle" = 'Design Engineer'

union

SELECT 
      p."FirstName", 
      p."LastName",  
      e."JobTitle"
FROM humanresources.employee e
JOIN person.person p 
  ON e."BusinessEntityID" = p."BusinessEntityID"
WHERE e."JobTitle" = 'Control Specialist'

--Q5
SELECT 
      p."FirstName", 
      p."LastName",
      d."Name" AS "DepartmentName", 
      e."JobTitle"
FROM humanresources.employee e
JOIN person.person p 
  ON e."BusinessEntityID" = p."BusinessEntityID"
JOIN humanresources.employee_department_history dh 
  ON e."BusinessEntityID" = dh."BusinessEntityID"
JOIN humanresources.department d
  ON dh."DepartmentID" = d."DepartmentID"
WHERE dh."EndDate" IS NULL

--Q6
SELECT 
      p."BusinessEntityID",
      p."FirstName", 
      p."LastName"
FROM humanresources.employee e
JOIN person.person p 
  ON e."BusinessEntityID" = p."BusinessEntityID"
JOIN humanresources.employee_department_history dh 
  ON e."BusinessEntityID" = dh."BusinessEntityID"
LEFT JOIN person.phone pp ON pp."BusinessEntityID" = p."BusinessEntityID"
WHERE dh."EndDate" IS NULL AND pp."BusinessEntityID" IS NULL

--Q7
SELECT 
      e."BusinessEntityID",
      pp."PhoneNumber"
FROM humanresources.employee e
JOIN person.phone pp ON pp."BusinessEntityID" = e."BusinessEntityID"

--Q8
SELECT 
      p."FirstName", 
      p."LastName"
FROM humanresources.employee e
JOIN person.person p 
  ON e."BusinessEntityID" = p."BusinessEntityID"
WHERE e."JobTitle" = 'Design Engineer'

except

SELECT 
      p."FirstName", 
      p."LastName"
FROM humanresources.employee e
JOIN person.person p 
  ON e."BusinessEntityID" = p."BusinessEntityID"
JOIN humanresources.employee_department_history dh 
  ON e."BusinessEntityID" = dh."BusinessEntityID"
JOIN humanresources.department d
  ON dh."DepartmentID" = d."DepartmentID"
WHERE d."Name" = 'Engineering'

--Q9

SELECT
    p."BusinessEntityID",
    p."FirstName",
    p."LastName",
    pp."PhoneNumber"
FROM person.person p
JOIN humanresources.employee e
    ON p."BusinessEntityID" = e."BusinessEntityID"
JOIN humanresources.employee_department_history dh
    ON e."BusinessEntityID" = dh."BusinessEntityID"
JOIN person.phone pp
    ON pp."BusinessEntityID" = e."BusinessEntityID"
JOIN person.phone_number_type nt
    ON pp."PhoneNumberTypeID" = nt."PhoneNumberTypeID"
WHERE dh."EndDate" IS NULL
  AND nt."Name" = 'Cell';


